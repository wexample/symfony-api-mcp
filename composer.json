{
  "name": "wexample/symfony-api-mcp",
  "description": "The application's api as an MCP server, at /api/mcp, its tools declared on services",
  "version": "3.0.0",
  "type": "symfony-bundle",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "wexample/symfony-helpers": ">=19.1.0",
    "symfony/mcp-bundle": "^0.15",
    "nyholm/psr7": "^1.8",
    "wexample/symfony-api": ">=20.0.0"
  },
  "require-dev": {
    "wexample/symfony-testing": ">=6.0.0",
    "phpunit/phpunit": "^13",
    "symfony/browser-kit": "^7.4|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyApiMcp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyApiMcp\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ]
}