{%- extends '@front/layouts/private/layout.html.twig' -%}

{#- The MCP server, beside the api's page: where an agent connects and how,
    then the tools it finds there. `server`: url, command, tools
    (McpDocumentationService::describe). -#}

{#- Wide: each tool's arguments beside a call of it, a table and a block of
    code side by side. -#}
{%- set page_body_mode = 'large' -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>

    <div class="doc">
        <section class="doc-section">
            <div class="doc-section--description">
                <h3>{{ '@page::section_endpoint' | trans }}</h3>
                <p><code>{{ server.url }}</code></p>
                <p class="text-secondary">{{ '@page::authentication' | trans }}</p>
            </div>
            <div class="doc-section--code">
                {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', { lang: 'bash', code: server.command }) }}
            </div>
        </section>

        <h2>{{ '@page::section_tools' | trans }}</h2>
        {%- if server.tools is empty %}
            <p class="empty">{{ '@page::no_tools' | trans }}</p>
        {%- else %}
            {#- Every tool at hand, leading to its section. -#}
            <nav class="cluster" aria-label="{{ '@page::section_tools' | trans }}">
                {%- for tool in server.tools %}
                    <a class="text-link" href="#tool-{{ tool.name }}"><code>{{ tool.name }}</code></a>
                {%- endfor %}
            </nav>

            {#- A tool as an operation of the api's page is: what it is and
                takes on one side, a call of it on the other. -#}
            {%- for tool in server.tools %}
                <section class="doc-section" id="tool-{{ tool.name }}">
                    <div class="doc-section--description">
                        <h3 class="cluster">
                            <code>{{ tool.name }}</code>
                            {%- if tool.readOnly %}{{ marker('neutral', '@page::read_only' | trans, { compact: true }) }}{% endif -%}
                        </h3>
                        {%- if tool.title %}<p><strong>{{ tool.title }}</strong></p>{% endif %}
                        {%- if tool.description %}{{ tool.description | markdown }}{% endif %}

                        {%- if tool.arguments is not empty %}
                            <h4>{{ '@page::section_arguments' | trans }}</h4>
                            {#- Their words, where the api's document gives some. -#}
                            {%- set described = tool.arguments | filter(argument => argument.description) is not empty -%}
                            {{ data_table([
                                { key: 'name', label: '@page::column.name' | trans, cell: 'code' },
                                { key: 'type', label: '@page::column.type' | trans, cell: 'code', secondary: true },
                                { key: 'required', label: '', cell: 'status' },
                            ] | merge(described ? [{ key: 'description', label: '@page::column.description' | trans }] : []), tool.arguments | map(argument => {
                                name: argument.name,
                                type: argument.type,
                                required: argument.required ? { type: 'neutral', label: '@page::required' | trans } : null,
                                description: argument.description,
                            }), { fill: true }) }}
                        {%- endif %}
                    </div>
                    <div class="doc-section--code">
                        {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', { lang: 'json', code: tool.example }) }}
                    </div>
                </section>
            {%- endfor %}
        {%- endif %}
    </div>
{%- endblock -%}
